# Data artifacts (regenerated via `make data`)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results (regenerated by the pipeline)
# Figures & metric CSVs ARE committed so the README renders on GitHub and the
# headline result is visible without cloning. Only heavy/raw artifacts stay out.
results/figures/*
!results/figures/.gitkeep
!results/figures/*.png
results/metrics/*
!results/metrics/.gitkeep
!results/metrics/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Models / checkpoints
*.pt
*.pth
checkpoints/
